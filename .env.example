# ============================================================
# FANZA GraphQL Payload 捕获器 —— 环境变量模板
# 使用方式：复制为 .env 后按需修改
#   cp .env.example .env
# 说明：页面 URL 已统一收敛到 config/pages.py，
#       本文件只保留「环境相关 / 私密」的配置项。
# ============================================================

# ── GraphQL 接口地址 ──────────────────────────────────────
GRAPHQL_API_URL=https://api.video.dmm.co.jp/graphql

# ── 飞书群机器人 ──────────────────────────────────────────
# 每次运行结束后推送一条运行摘要
FEISHU_GROUP_BOT_WEBHOOK_URL=
# 若机器人开启了「签名校验」，在此填入密钥；未开启则留空
FEISHU_SIGN_SECRET=

# ── Cloudflare R2 对象存储 ────────────────────────────────
# 每次运行结束后，把本轮写出的 PAYLOAD_*.json / HEADERS_*.json 上传到 R2。
# 这一组「要么全填、要么全空」：全空表示关闭上传。
#   端点二选一：填 R2_ACCOUNT_ID 会自动拼出
#   https://<account_id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
# 如需自定义 / 区域端点，填这里（优先级高于 R2_ACCOUNT_ID）
R2_ENDPOINT=
# 存储桶名称
R2_BUCKET=
# R2 → API → 管理令牌 里生成的密钥对
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 可选：对象键前缀，例如填 fanza 则上传到 fanza/PAYLOAD/...
R2_PREFIX=

# ── 浏览器 ────────────────────────────────────────────────
# 是否无头模式（VPS 上保持 true）
BROWSER_HEADLESS=true
# 可选代理，例如 http://127.0.0.1:7890；留空表示不使用
BROWSER_PROXY=
# 单页等待 GraphQL 请求的最长秒数
PAGE_WAIT_SECONDS=45
# 单个页面的最大重试次数
MAX_RETRY=3

# ── 日志 ──────────────────────────────────────────────────
# 覆盖 config/logging.py 中的控制台日志级别（留空则使用配置文件默认值）
LOG_LEVEL=
